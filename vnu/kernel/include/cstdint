// Freestanding C++20 <cstdint> shim. The kernel compiles with -nostdinc++
// and must not depend on the host's libc++/libstdc++, so the standard
// integer aliases are re-exported from the compiler's freestanding
// <stdint.h> into namespace std here.

#pragma once
#include <stdint.h>

namespace std {
using ::int8_t;
using ::int16_t;
using ::int32_t;
using ::int64_t;
using ::uint8_t;
using ::uint16_t;
using ::uint32_t;
using ::uint64_t;
using ::intptr_t;
using ::uintptr_t;
using ::intmax_t;
using ::uintmax_t;
} // namespace std